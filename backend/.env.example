# GoldScan AI Backend Configuration
# Copy this file to .env and fill in your values — never commit .env to git

# ── Required ──────────────────────────────────────────────────────────────

# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Mode ──────────────────────────────────────────────────────────────────

# Set to 'true' for production: disables all mocks, fails loudly on API errors
# Set to 'false' (default) for development: falls back to safe demo data
PRODUCTION_MODE=false

# ── Database ──────────────────────────────────────────────────────────────

# SQLite file path (relative to backend directory)
# For PostgreSQL: postgresql+asyncpg://user:pass@host/dbname
DATABASE_URL=./goldscan.db

# ── Server ────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
