# GoldScan AI Frontend Configuration
# Copy this file to .env and fill in your values — never commit .env to git

# Backend API URL — where the FastAPI server is running
# For local development: http://localhost:8000
# For production: your deployed backend URL (e.g. https://goldscan-api.onrender.com)
VITE_API_URL=http://localhost:8000

# NOTE: VITE_GEMINI_API_KEY has been intentionally removed.
# All Gemini AI vision analysis is proxied through the FastAPI backend.
# The API key lives in backend/.env only — it is never bundled into the browser JS.
